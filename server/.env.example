DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=verify-full
# ORIGIN_TOKEN=generate-a-long-random-secret-for-production
# Server-side only. Never prefix with VITE_ (that would ship it to the browser).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Optional Twilio SMS alert on each saved mission (all four needed to enable).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
# Public site URL, used for the report link in the SMS.
PUBLIC_URL=https://basescout.basescout-team.workers.dev
