{
  "name": "basescout",
  "compatibility_date": "2026-11-14",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Live telemetry relay: the Pi pushes, browsers watch (see worker.js).
  "durable_objects": {
    "bindings": [{ "name": "TELEMETRY", "class_name": "TelemetryRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TelemetryRelay"] }]
}
