# Starts the BaseScout telemetry server at boot.
# Install (adjust User and the path if your Pi username or clone location differ):
#   sudo cp pi/basescout-telemetry.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now basescout-telemetry
# Logs: journalctl -u basescout-telemetry -f
[Unit]
Description=BaseScout Live Earth demo telemetry
After=network-online.target
Wants=network-online.target

[Service]
User=udaya
Environment=PYTHONUNBUFFERED=1
# Optional cloud relay settings (RELAY_URL, RELAY_TOKEN). The file is git-ignored.
EnvironmentFile=-/home/udaya/BaseScout/pi/.env
WorkingDirectory=/home/udaya/BaseScout
ExecStart=/usr/bin/python3 /home/udaya/BaseScout/pi/telemetry.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
